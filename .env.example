# --- provider keys (you need the key for the provider used by the models below) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # pip install -e ".[openai]"
# TAVILY_API_KEY=            # pip install -e ".[tavily]"; without a key, DuckDuckGo is used

# --- models: a "provider:model" string for init_chat_model ---
RT_MAIN_MODEL=anthropic:claude-sonnet-5-5
RT_FAST_MODEL=anthropic:claude-haiku-5-5
# RT_MAIN_MODEL=openai:gpt-5.5

# --- budgets and behavior ---
RT_MAX_SUBQUESTIONS=4
RT_MAX_REVISIONS=2
RT_RESEARCHER_MAX_TOOL_CALLS=6
RT_SEARCH_BACKEND=auto       # auto | tavily | duckduckgo

# --- observability (optional): traces of all agents in LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=research-team
